{
  "name": "clinic-screen-bright",
  "label": "诊室门边屏·明亮科技",
  "version": 3,
  "preset": "tech",
  "colors": {
    "primary": "#0EA5E9",
    "primaryHover": "#38BDF8",
    "secondary": "#64748B",
    "background": "#F0F9FF",
    "surface": "#FFFFFF",
    "surfaceElevated": "#F8FAFC",
    "border": "#BAE6FD",
    "text": {
      "primary": "#0C4A6E",
      "secondary": "#64748B",
      "inverse": "#FFFFFF"
    },
    "accent": "#6366F1",
    "success": "#22C55E",
    "warning": "#F59E0B",
    "error": "#EF4444"
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Code', Consolas, monospace"
    },
    "scale": "comfortable",
    "weight": {
      "normal": 400,
      "medium": 500,
      "bold": 600
    }
