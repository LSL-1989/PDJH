# 开发时 /api 代理到 pdjh-server（与 server.port 一致；若用 SERVER_PORT=8082 则改为 http://127.0.0.1:8082）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8081

# 安卓局域网调试请用：npm run android:lan（build + preview，无 import.meta.hot 兼容问题）

# 可选：本地打开签到页时默认填入患者编号（须库中有对应待签到记录）
# VITE_DEV_DEFAULT_PATIENT_CODE=P241101

# 可选：医院名称 / Logo、设备号（与门边屏同键；也可通过 URL ?deviceId= 传入）
VITE_HOSPITAL_NAME=某某医院
# VITE_HOSPITAL_LOGO=
# VITE_DEVICE_ID=QD-001
