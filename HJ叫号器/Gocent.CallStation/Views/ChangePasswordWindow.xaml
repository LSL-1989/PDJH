<Window x:Class="Gocent.CallStation.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改密码"
        Width="500" SizeToContent="Height"
        MinHeight="420"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True">
  <Border Style="{StaticResource GlassPanel}" Padding="24">
    <StackPanel>
      <Grid MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock Text="修改密码" FontSize="24" FontWeight="SemiBold" Margin="0,0,108,0"
                   Foreground="{DynamicResource HighlightBrush}" VerticalAlignment="Center" />
        <Button x:Name="BtnTheme" Content="浅色主题" Style="{StaticResource ThemeToggleButton}"
                HorizontalAlignment="Right" Click="Theme_Click" ToolTip="切换深色或浅色主题" />
      </Grid>
      <TextBlock x:Name="TxtHint" Text="请设置新密码" FontSize="17" Margin="0,10,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

      <TextBlock Text="原密码" FontSize="17" Margin="0,16,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
      <PasswordBox x:Name="TxtOld" Style="{StaticResource DarkPassword}" Height="50" />

      <TextBlock Text="新密码" FontSize="17" Margin="0,14,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
      <PasswordBox x:Name="TxtNew" Style="{StaticResource DarkPassword}" Height="50" />

      <TextBlock Text="确认密码" FontSize="17" Margin="0,14,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
      <PasswordBox x:Name="TxtConfirm" Style="{StaticResource DarkPassword}" Height="50" />

      <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}" FontSize="16"
                 TextWrapping="Wrap" MinHeight="32" Margin="0,10,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="取消" Style="{StaticResource SoftGhostButton}" Width="108" Height="42" Margin="0,0,10,0" Click="Cancel_Click" />
        <Button Content="确定" Style="{StaticResource SoftPrimaryButton}" Width="108" Height="42" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
