<Window x:Class="Gocent.CallStation.Views.CompactFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="精简叫号"
        Width="210" Height="210"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">
  <!-- 外圈预留阴影空间，避免 DropShadow 被窗口裁切 -->
  <Border x:Name="HoverHost"
          Background="#01FFFFFF"
          MouseEnter="HoverHost_MouseEnter"
          MouseLeave="HoverHost_MouseLeave"
          VerticalAlignment="Top" HorizontalAlignment="Left"
          Padding="18">
    <StackPanel x:Name="ContentRow" Orientation="Horizontal" VerticalAlignment="Top">
      <Grid Width="168" Height="168" MouseLeftButtonDown="Circle_MouseLeftButtonDown" VerticalAlignment="Top">
        <Ellipse Width="168" Height="168" Fill="{DynamicResource Float3DBrush}">
          <Ellipse.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Direction="270" Color="#041018" />
          </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="116" Height="50" Fill="#55FFFFFF" Opacity="0.35"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
          <Ellipse.Effect>
            <BlurEffect Radius="8" />
          </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="150" Height="150" Stroke="#66FFFFFF" StrokeThickness="1.5"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.35" />
        <StackPanel VerticalAlignment="Center" Panel.ZIndex="1">
          <TextBlock x:Name="TxtName" Text="—" FontSize="24" FontWeight="Bold" Foreground="White"
                     TextAlignment="Center" Margin="14,0" TextWrapping="Wrap" MaxHeight="64" />
          <TextBlock x:Name="TxtMeta" Text="- · - · -" FontSize="16" Foreground="#F4FCFF"
                     TextAlignment="Center" Margin="12,8,12,0" TextWrapping="Wrap" />
        </StackPanel>
        <!-- 四个操作失败时盖在悬浮球上，红字，3 秒后收起。 -->
        <Grid x:Name="BallErrorMask" Visibility="Collapsed" Panel.ZIndex="2">
          <Ellipse Width="168" Height="168" Fill="#FF0B1E33" />
          <TextBlock x:Name="TxtBallError" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" HorizontalAlignment="Center" Margin="22,16"
                     FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
        </Grid>
      </Grid>

      <Border x:Name="BtnPanel" Visibility="Collapsed"
              Background="{DynamicResource FloatPanelBrush}" CornerRadius="12"
              BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="1"
              Padding="8" Margin="8,0,0,0" Width="160"
              VerticalAlignment="Top">
        <Border.Effect>
          <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="#041018" />
        </Border.Effect>
        <StackPanel>
          <!-- 与列表模式一致：呼叫下一位用主色，其余次按钮圆角 8。完成紧挨在过号下面，底色相同。 -->
          <Button Content="呼叫下一位" Style="{StaticResource SoftPrimaryButton}" Margin="0,0,0,6" MinHeight="44" FontSize="16" Click="CallNext_Click" />
          <Button Content="重呼" Style="{StaticResource SoftGhostButton}" Margin="0,0,0,6" MinHeight="44" FontSize="16" Click="Recall_Click" />
          <Button Content="过号" Style="{StaticResource SoftGhostButton}" Margin="0,0,0,6" MinHeight="44" FontSize="16" Click="Pass_Click" />
          <Button x:Name="BtnComplete" Content="完成" Style="{StaticResource SoftGhostButton}" Margin="0,0,0,6" MinHeight="44" FontSize="16" Click="Complete_Click" />
          <Button Content="列表模式" Style="{StaticResource SoftGhostButton}" Margin="0,0,0,6" MinHeight="44" FontSize="16" Click="Switch_Click" />
          <Button Content="退出" Style="{StaticResource SoftGhostButton}" Foreground="{DynamicResource DangerBrush}" MinHeight="44" FontSize="16" Click="Exit_Click" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
