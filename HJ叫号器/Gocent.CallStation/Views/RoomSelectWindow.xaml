<Window x:Class="Gocent.CallStation.Views.RoomSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认窗口"
        Width="500" SizeToContent="Height"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Border Style="{StaticResource GlassPanel}" Padding="24">
    <StackPanel>
      <Grid MouseLeftButtonDown="Title_MouseLeftButtonDown">
        <TextBlock x:Name="TxtTitle" Text="确认窗口" FontSize="24" FontWeight="SemiBold"
                   Foreground="{DynamicResource HighlightBrush}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock x:Name="TxtHint" Text="确认后将在对应门口展示值班信息" FontSize="17" Margin="0,10,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

      <TextBlock x:Name="TxtRoomLabel" Text="当前窗口" FontSize="17" Margin="0,18,0,8" Foreground="{DynamicResource TextSecondaryBrush}" />
      <ComboBox x:Name="CmbRoom" Height="52" DisplayMemberPath="Name"
                Style="{StaticResource DarkComboBox}" />

      <TextBlock x:Name="TxtError" Foreground="{DynamicResource DangerBrush}" FontSize="16"
                 MinHeight="28" Margin="0,10,0,0" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="取消" Style="{StaticResource SoftGhostButton}" Width="108" Height="42" Margin="0,0,10,0" Click="Cancel_Click" />
        <Button x:Name="BtnOk" Content="确认上岗" Style="{StaticResource SoftPrimaryButton}" MinWidth="132" Height="42"
                IsDefault="True" Click="Ok_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
