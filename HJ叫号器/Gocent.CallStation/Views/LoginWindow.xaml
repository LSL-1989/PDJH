<Window x:Class="Gocent.CallStation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录叫号器"
        Width="468" Height="680"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- 外圈留白给投影。卡片本身裁成圆角，窗口四角保持透明。 -->
  <Grid>
    <Border Margin="14" CornerRadius="8" Background="#335B7A99" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="10" />
      </Border.Effect>
    </Border>
    <Border x:Name="WindowShell" Margin="14" CornerRadius="8" BorderThickness="1" Padding="22,16"
            Background="{DynamicResource CardFaceBrush}"
            BorderBrush="{DynamicResource BorderGlassBrush}"
            SizeChanged="WindowShell_SizeChanged"
            MouseLeftButtonDown="Title_MouseLeftButtonDown">
    <Grid>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2">
        <Button x:Name="BtnTheme" Style="{StaticResource ThemeToggleButton}"
                Click="Theme_Click" Margin="0,0,6,0" ToolTip="切换深色或浅色主题">
          <StackPanel Orientation="Horizontal">
            <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
              <Ellipse Stroke="{DynamicResource HeaderTextBrush}" StrokeThickness="1.2" />
              <Path Fill="{DynamicResource HeaderTextBrush}" Data="M6,1.2 A4.8,4.8 0 0 1 6,10.8 Z" />
            </Grid>
            <TextBlock x:Name="TxtThemeLabel" Text="浅色主题" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click" />
      </StackPanel>

      <StackPanel Margin="16,28,16,8" VerticalAlignment="Center">
        <Grid Width="108" Height="108" HorizontalAlignment="Center">
          <Ellipse Stroke="{DynamicResource LogoGrad}" StrokeThickness="5">
            <Ellipse.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.85" Color="#2AD4F0" />
            </Ellipse.Effect>
          </Ellipse>
          <Ellipse Width="90" Height="90" Fill="{DynamicResource LogoDiscBrush}" />
          <Grid Width="52" Height="52">
            <Border Width="16" Height="52" CornerRadius="4" Background="{DynamicResource HeroGrad}" />
            <Border Width="52" Height="16" CornerRadius="4" Background="{DynamicResource HeroGrad}" />
          </Grid>
        </Grid>

        <TextBlock x:Name="TxtHospital" Text="医院名称" FontSize="32" FontWeight="Bold"
                   Margin="0,22,0,0" Foreground="{DynamicResource HighlightBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="登录叫号器" FontSize="32" FontWeight="Bold" Margin="0,2,0,0"
                   Foreground="{DynamicResource HighlightBrush}"
                   HorizontalAlignment="Center" TextAlignment="Center" />

        <Grid Margin="6,28,6,0" Height="56">
          <TextBox x:Name="TxtAccount" Style="{StaticResource DarkInput}" Padding="16,0"
                   TextChanged="Account_TextChanged" GotFocus="Field_FocusChanged" LostFocus="Field_FocusChanged" />
          <TextBlock x:Name="PhAccount" Text="用户（工号/手机号）" IsHitTestVisible="False"
                     Margin="18,0,16,0" VerticalAlignment="Center" FontSize="16"
                     Foreground="{DynamicResource PlaceholderBrush}" />
        </Grid>

        <Grid Margin="6,14,6,0" Height="56">
          <PasswordBox x:Name="TxtPassword" Style="{StaticResource DarkPassword}" Padding="16,0,46,0"
                       PasswordChanged="Password_Changed" GotFocus="Field_FocusChanged" LostFocus="Field_FocusChanged" />
          <TextBox x:Name="TxtPasswordVisible" Style="{StaticResource DarkInput}" Padding="16,0,46,0"
                   Visibility="Collapsed" TextChanged="Account_TextChanged"
                   GotFocus="Field_FocusChanged" LostFocus="Field_FocusChanged" />
          <TextBlock x:Name="PhPassword" Text="密码" IsHitTestVisible="False"
                     Margin="18,0,48,0" VerticalAlignment="Center" FontSize="16"
                     Foreground="{DynamicResource PlaceholderBrush}" />
          <ToggleButton x:Name="BtnTogglePwd" Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Checked="TogglePwd_Checked" Unchecked="TogglePwd_Unchecked"
                        ToolTip="显示/隐藏密码">
            <Path x:Name="EyeIcon" Width="22" Height="14" Stretch="Uniform"
                  Stroke="{DynamicResource PlaceholderBrush}" StrokeThickness="1.4"
                  Fill="Transparent"
                  Data="M1,7 C4.2,2.6 11.8,2.6 15,7 C11.8,11.4 4.2,11.4 1,7 Z M8,5.2 A1.8,1.8 0 1 1 7.99,8.8 A1.8,1.8 0 1 1 8,5.2 Z" />
          </ToggleButton>
        </Grid>

        <TextBlock x:Name="TxtError" Margin="8,8,8,0" FontSize="14" MinHeight="18"
                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

        <Button x:Name="BtnLogin" Content="进入叫号器" Style="{StaticResource PrimaryButton}"
                Height="54" Margin="6,10,6,0" FontSize="20" IsDefault="True" Click="Login_Click" />

        <TextBlock x:Name="TxtForgot" Text="忘记密码" Style="{StaticResource LinkText}"
                   Foreground="{DynamicResource ForgotBrush}" FontSize="16"
                   HorizontalAlignment="Center" Margin="0,16,0,0"
                   MouseLeftButtonUp="Forgot_Click" />
      </StackPanel>
    </Grid>
    </Border>
  </Grid>
</Window>
