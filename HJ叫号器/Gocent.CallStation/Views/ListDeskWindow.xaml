<Window x:Class="Gocent.CallStation.Views.ListDeskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HJ叫号器"
        Width="520" Height="960"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        Left="24" Top="16">
  <!-- 外圈留白给投影。卡片裁成小圆角，窗口四角保持透明。 -->
  <Grid>
    <Border Margin="12" CornerRadius="8" Background="#335B7A99" IsHitTestVisible="False">
      <Border.Effect>
        <BlurEffect Radius="10" />
      </Border.Effect>
    </Border>
    <Border x:Name="WindowShell" Margin="12" CornerRadius="8" BorderThickness="1" Background="{DynamicResource WindowGrad}"
            BorderBrush="{DynamicResource BorderGlassBrush}" SizeChanged="WindowShell_SizeChanged">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Margin="0" Padding="14,10,8,10" CornerRadius="0"
              Background="{DynamicResource HeaderGrad}"
              BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" MaxWidth="136" Margin="0,0,8,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TxtDoctorName" Text="值班员" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="78" />
            <Ellipse x:Name="OnlineDot" Width="8" Height="8" Fill="{DynamicResource DangerBrush}"
                     Margin="6,0,4,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtOnline" Text="离线" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}" />
          </StackPanel>
          <TextBlock x:Name="TxtDoctorTitle" Text="职称" FontSize="14" Margin="0,2,0,0"
                     Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- 诊室名占医生信息与齿轮之间的全部宽度，过长换行，不再裁成滚动条。 -->
        <TextBlock x:Name="TxtRoom" Grid.Column="1" Text="诊室" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource HeaderTextBrush}"
                   TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="4,0" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Grid>
            <Button x:Name="BtnGear" Style="{StaticResource ChromeButton}" Width="32" Height="32"
                    Click="Gear_Click" ToolTip="设置">
              <Path Width="16" Height="16" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
            </Button>
            <Popup x:Name="GearPopup" PlacementTarget="{Binding ElementName=BtnGear}" Placement="Bottom"
                   HorizontalOffset="-108" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
              <Border MinWidth="148" Padding="4" CornerRadius="8" Background="{DynamicResource DropDownBrush}"
                      BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="1">
                <StackPanel>
                  <Button x:Name="BtnGearTheme" Content="浅色主题" Style="{StaticResource MenuItemButton}" Click="Theme_Click" />
                  <Button Content="简易模式" Style="{StaticResource MenuItemButton}" Click="SwitchCompact_Click" />
                </StackPanel>
              </Border>
            </Popup>
          </Grid>
          <Button Content="✕" Style="{StaticResource ChromeButton}" Click="Close_Click" />
        </StackPanel>
      </Grid>
      </Border>

      <Border Grid.Row="1" Margin="14,14,14,0" Padding="16,14,16,16" CornerRadius="12"
              Background="{DynamicResource InsetBrush}" BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.14" Color="#5B7A99" />
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="当前呼叫" FontSize="13" HorizontalAlignment="Left"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock x:Name="TxtCurrentNo" Text="—" FontSize="78" FontWeight="Bold"
                     HorizontalAlignment="Center" Margin="0,0,0,0"
                     Foreground="{DynamicResource HeroGrad}" />
          <TextBlock x:Name="TxtCurrentMeta" Text="暂无正在呼叫的患者" FontSize="14"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Margin="4,2,4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock x:Name="TxtExamHint" Text="" Visibility="Collapsed" FontSize="13"
                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                     Margin="4,4,4,0" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="2" Margin="14,12,14,0" Height="44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.55*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Style="{StaticResource SoftPrimaryButton}" Margin="0,0,8,0" FontSize="16" Click="CallNext_Click" Content="呼叫下一位" />
        <Button Grid.Column="1" Style="{StaticResource SoftGhostButton}" Margin="0,0,8,0" FontSize="16" Click="Recall_Click" Content="重呼" />
        <Button Grid.Column="2" Style="{StaticResource SoftGhostButton}" Margin="0,0,8,0" FontSize="16" Click="Pass_Click" Content="过号" />
        <Button Grid.Column="3" Style="{StaticResource SoftGhostButton}" FontSize="16" Click="Complete_Click" Content="完成" />
      </Grid>

      <Border x:Name="PharmacyScanBar" Grid.Row="3" Margin="16,12,16,0" Background="{DynamicResource InsetBrush}"
              CornerRadius="14" Padding="10" BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="1"
              Visibility="Collapsed">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="扫码叫号" Style="{StaticResource PrimaryButton}"
                  Padding="14,8" FontSize="15" Click="ScanCall_Click" Margin="8,0,0,0" />
          <TextBox x:Name="TxtScanCode" Style="{StaticResource DarkInput}" Height="46"
                   ToolTip="扫码或输入患者编号/取药号后回车" KeyDown="ScanCode_KeyDown" />
        </DockPanel>
      </Border>

      <Border Grid.Row="4" Margin="14,12,14,0" CornerRadius="12" BorderThickness="1"
              BorderBrush="{DynamicResource BorderGlassBrush}" Background="{DynamicResource InsetBrush}" Padding="8,8,8,6">
        <Border.Effect>
          <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.14" Color="#5B7A99" />
        </Border.Effect>
        <Grid>
        <DockPanel>
          <UniformGrid x:Name="TabHeaderGrid" DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TabWait_Click">
              <StackPanel>
                <TextBlock x:Name="TxtTabWaiting" Text="等候" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{DynamicResource PrimaryBrush}" />
                <Border x:Name="MarkWaiting" Height="3" Width="32" CornerRadius="1.5" Margin="0,5,0,0"
                        HorizontalAlignment="Center" Background="{DynamicResource PrimaryBrush}" />
              </StackPanel>
            </Button>
            <Button x:Name="BtnTabPreparing" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Visibility="Collapsed" Click="TabPrep_Click">
              <StackPanel>
                <TextBlock x:Name="TxtTabPreparing" Text="配药中" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border x:Name="MarkPreparing" Height="3" Width="32" CornerRadius="1.5" Margin="0,5,0,0"
                        HorizontalAlignment="Center" Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed" />
              </StackPanel>
            </Button>
            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TabDone_Click">
              <StackPanel>
                <TextBlock x:Name="TxtTabDone" Text="已完成" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border x:Name="MarkDone" Height="3" Width="32" CornerRadius="1.5" Margin="0,5,0,0"
                        HorizontalAlignment="Center" Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed" />
              </StackPanel>
            </Button>
            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TabPass_Click">
              <StackPanel>
                <TextBlock x:Name="TxtTabPassed" Text="过号" FontSize="15" HorizontalAlignment="Center"
                           Foreground="{DynamicResource DangerBrush}" />
                <Border x:Name="MarkPassed" Height="3" Width="28" CornerRadius="1.5" Margin="0,5,0,0"
                        HorizontalAlignment="Center" Background="{DynamicResource DangerBrush}" Visibility="Collapsed" />
              </StackPanel>
            </Button>
          </UniformGrid>

          <Grid>
            <DockPanel x:Name="PanelWaiting">
              <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="8,7" CornerRadius="6"
                      Background="{DynamicResource TableHeaderBrush}"
                      BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="40" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="78" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="状态" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="序号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="姓名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="性别" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="年龄" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="操作" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
              </Border>
              <ListBox x:Name="ListWaiting" Style="{StaticResource QueueListBox}" ItemContainerStyle="{StaticResource QueueRow}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="78" />
                      </Grid.ColumnDefinitions>
                      <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Fill="{DynamicResource AmberBrush}" ToolTip="{Binding StatusLabel}"
                            Data="M8,1.4 C8.7,1.4 9.2,1.9 9.2,2.6 L9.2,3.3 C11.6,3.9 13.2,6.1 13.2,8.8 L13.2,11.2 L14.4,12.4 L14.4,13.3 L1.6,13.3 L1.6,12.4 L2.8,11.2 L2.8,8.8 C2.8,6.1 4.4,3.9 6.8,3.3 L6.8,2.6 C6.8,1.9 7.3,1.4 8,1.4 Z M6.1,14.2 A1.9,1.9 0 0 0 9.9,14.2 Z" />
                      <TextBlock Grid.Column="1" Text="{Binding SeqDisplay}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding PatientName}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding SexDisplay}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontSize="14" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding AgeDisplay}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 FontSize="14" VerticalAlignment="Center" />
                      <Button Grid.Column="5" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                              Padding="8,3" MinHeight="28" Click="CallSpecific_Click" Tag="{Binding}" ToolTip="{Binding StatusLabel}">
                        <StackPanel Orientation="Horizontal">
                          <Path Width="11" Height="11" Stretch="Uniform" Margin="0,0,3,0" Fill="{DynamicResource PrimaryTextBrush}"
                                Data="M6.6,10.8 C8.6,12.8 11,13.8 12.6,14.2 C13.1,14.3 13.6,14 13.7,13.5 L14,11.6 C14.1,11.1 13.8,10.6 13.3,10.4 L11.6,9.8 C11.2,9.6 10.7,9.8 10.4,10.1 L9.8,10.9 C8.4,10.2 7.3,9.1 6.6,7.7 L7.4,7.1 C7.7,6.8 7.9,6.3 7.7,5.9 L7.1,4.2 C6.9,3.7 6.4,3.4 5.9,3.5 L4,3.8 C3.5,3.9 3.2,4.4 3.3,4.9 C3.7,6.5 4.7,8.9 6.6,10.8 Z" />
                          <TextBlock Text="呼叫" FontSize="13" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <DockPanel x:Name="PanelPreparing" Visibility="Collapsed">
              <ListBox x:Name="ListPreparing" Style="{StaticResource QueueListBox}" ItemContainerStyle="{StaticResource QueueRow}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource AmberBrush}" FontSize="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SeqDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding PatientName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="3" Content="配完" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                              Padding="8,3" MinHeight="28" FontSize="13" Click="MarkReady_Click" Tag="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <DockPanel x:Name="PanelDone" Visibility="Collapsed">
              <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="8,7" CornerRadius="6"
                      Background="{DynamicResource TableHeaderBrush}"
                      BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="状态" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="序号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="姓名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="性别" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="年龄" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
              </Border>
              <ListBox x:Name="ListDone" Style="{StaticResource QueueListBox}" ItemContainerStyle="{StaticResource QueueRow}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding VisitLabel}" Foreground="{DynamicResource SuccessBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SeqDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding PatientName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding SexDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding AgeDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>

            <DockPanel x:Name="PanelPassed" Visibility="Collapsed">
              <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="8,7" CornerRadius="6"
                      Background="{DynamicResource TableHeaderBrush}"
                      BorderBrush="{DynamicResource BorderGlassBrush}" BorderThickness="0,0,0,1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="状态" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="序号" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="姓名" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="性别" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="年龄" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
              </Border>
              <ListBox x:Name="ListPassed" Style="{StaticResource QueueListBox}" ItemContainerStyle="{StaticResource QueueRow}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="48" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding VisitLabel}" Foreground="{DynamicResource DangerBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding SeqDisplay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding PatientName}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding SexDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding AgeDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Grid>
        </DockPanel>
        <!-- 呼叫/重呼/过号/完成失败时盖在患者列表上，红字，3 秒后收起。 -->
        <Border x:Name="ListErrorMask" Visibility="Collapsed" CornerRadius="8" Background="#F20B1E33">
          <TextBlock x:Name="TxtListError" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,16"
                     FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
        </Border>
        </Grid>
      </Border>

      <TextBlock Grid.Row="5" Text="技术支持：南京吾爱网络技术有限公司"
                 Foreground="{DynamicResource FooterBrush}" FontSize="12"
                 HorizontalAlignment="Center" Margin="12,8,12,14" />
    </Grid>
    </Border>
  </Grid>
</Window>
