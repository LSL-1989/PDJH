<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    浅色叫号稿面。键名与深色板一致，由 ThemeService 整本替换。
    背景 #F5F8FC→#E4EDF5，卡片 #FFFFFF，主色 #00A3D8，主字 #0F2A44，次字 #5B7A99，
    描边 #C6D8E8，等候 #F5A623，完成/在线 #34C759，过号 #FF5A5A。
  -->
  <Color x:Key="BgDeepColor">#F5F8FC</Color>
  <Color x:Key="BgPanelColor">#E4EDF5</Color>
  <Color x:Key="GlassColor">#FFFFFF</Color>
  <Color x:Key="CyanColor">#00A3D8</Color>
  <Color x:Key="CyanDeepColor">#0088B8</Color>
  <Color x:Key="LifeGreenColor">#34C759</Color>
  <Color x:Key="WarnRedColor">#FF5A5A</Color>
  <Color x:Key="AmberColor">#F5A623</Color>
  <Color x:Key="TextPrimaryColor">#0F2A44</Color>
  <Color x:Key="TextSecondaryColor">#5B7A99</Color>
  <Color x:Key="BorderGlassColor">#C6D8E8</Color>
  <Color x:Key="RowAltColor">#F5F8FC</Color>
  <Color x:Key="RowBaseColor">#FFFFFF</Color>

  <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
  <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
  <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource GlassColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource CyanDeepColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1AB4E4" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource LifeGreenColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource WarnRedColor}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#C6D8E8" />
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#5B7A99" />
  <SolidColorBrush x:Key="GlowBrush" Color="#3300A3D8" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="BorderGlassBrush" Color="{StaticResource BorderGlassColor}" />
  <SolidColorBrush x:Key="RowLineBrush" Color="#C6D8E8" />
  <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}" />
  <SolidColorBrush x:Key="RowBaseBrush" Color="{StaticResource RowBaseColor}" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="#E4EDF5" />
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgPanelColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HighlightBrush" Color="#0F2A44" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#0F2A44" />
  <SolidColorBrush x:Key="HeaderSubBrush" Color="#5B7A99" />
  <SolidColorBrush x:Key="InsetBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LogoDiscBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TableHeaderBrush" Color="#F5F8FC" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#5B7A99" />
  <SolidColorBrush x:Key="FooterBrush" Color="#5B7A99" />
  <SolidColorBrush x:Key="ForgotBrush" Color="#5B7A99" />
  <SolidColorBrush x:Key="HighlightBorderBrush" Color="#00A3D8" />
  <SolidColorBrush x:Key="GhostBgBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="GhostHoverBrush" Color="#E4EDF5" />
  <SolidColorBrush x:Key="ComboHoverBrush" Color="#E4EDF5" />
  <SolidColorBrush x:Key="ComboSelectedBrush" Color="#D4F1F8" />
  <SolidColorBrush x:Key="ComboArrowBgBrush" Color="#F5F8FC" />
  <SolidColorBrush x:Key="DropDownBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="LinkBrush" Color="#00A3D8" />
  <SolidColorBrush x:Key="FloatPanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="CardFaceBrush" Color="#FFFFFF" />

  <LinearGradientBrush x:Key="WindowGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F5F8FC" Offset="0" />
    <GradientStop Color="#E4EDF5" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryGrad" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#1AB4E4" Offset="0" />
    <GradientStop Color="#00A3D8" Offset="0.55" />
    <GradientStop Color="#0088B8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryHoverGrad" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#3EC4EC" Offset="0" />
    <GradientStop Color="#00A3D8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#1496C4" Offset="0" />
    <GradientStop Color="#00A3D8" Offset="0.55" />
    <GradientStop Color="#0078A4" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LogoGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#3EC4EA" Offset="0" />
    <GradientStop Color="#00A3D8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#F5F8FC" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Float3DBrush" StartPoint="0.3,0" EndPoint="0.75,1">
    <GradientStop Color="#3EC4EA" Offset="0" />
    <GradientStop Color="#00A3D8" Offset="0.45" />
    <GradientStop Color="#0078A4" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
