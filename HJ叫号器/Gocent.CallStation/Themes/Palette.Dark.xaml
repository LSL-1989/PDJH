<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    深色叫号稿面。键名与浅色板一致，由 ThemeService 整本替换。
    背景 #0B1E33→#0F2A44，主色 #00B4D8，主字 #FFFFFF，次字 #A8C6E0，
    等候 #F5A623，完成/在线 #34C759，过号 #FF5A5A。
  -->
  <Color x:Key="BgDeepColor">#0B1E33</Color>
  <Color x:Key="BgPanelColor">#0F2A44</Color>
  <Color x:Key="GlassColor">#E6123048</Color>
  <Color x:Key="CyanColor">#00B4D8</Color>
  <Color x:Key="CyanDeepColor">#0096B8</Color>
  <Color x:Key="LifeGreenColor">#34C759</Color>
  <Color x:Key="WarnRedColor">#FF5A5A</Color>
  <Color x:Key="AmberColor">#F5A623</Color>
  <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
  <Color x:Key="TextSecondaryColor">#A8C6E0</Color>
  <Color x:Key="BorderGlassColor">#1E4E6A</Color>
  <Color x:Key="RowAltColor">#143450</Color>
  <Color x:Key="RowBaseColor">#102C46</Color>

  <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
  <SolidColorBrush x:Key="BgPanelBrush" Color="{StaticResource BgPanelColor}" />
  <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource GlassColor}" />
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource CyanDeepColor}" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#33C6E4" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource LifeGreenColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource WarnRedColor}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#2A6484" />
  <SolidColorBrush x:Key="PlaceholderBrush" Color="#A8C6E0" />
  <SolidColorBrush x:Key="GlowBrush" Color="#4400B4D8" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="BorderGlassBrush" Color="{StaticResource BorderGlassColor}" />
  <SolidColorBrush x:Key="RowLineBrush" Color="#1A3850" />
  <SolidColorBrush x:Key="RowAltBrush" Color="{StaticResource RowAltColor}" />
  <SolidColorBrush x:Key="RowBaseBrush" Color="{StaticResource RowBaseColor}" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="#1A4060" />
  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgPanelColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource GlassColor}" />
  <SolidColorBrush x:Key="InputBgBrush" Color="#0B1E33" />
  <SolidColorBrush x:Key="HighlightBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="HeaderSubBrush" Color="#A8C6E0" />
  <SolidColorBrush x:Key="InsetBrush" Color="#12324C" />
  <SolidColorBrush x:Key="LogoDiscBrush" Color="#0B1E33" />
  <SolidColorBrush x:Key="TableHeaderBrush" Color="#163654" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FooterBrush" Color="#A8C6E0" />
  <SolidColorBrush x:Key="ForgotBrush" Color="#A8C6E0" />
  <SolidColorBrush x:Key="HighlightBorderBrush" Color="#00B4D8" />
  <SolidColorBrush x:Key="GhostBgBrush" Color="#0F2A44" />
  <SolidColorBrush x:Key="GhostHoverBrush" Color="#184060" />
  <SolidColorBrush x:Key="ComboHoverBrush" Color="#1A4868" />
  <SolidColorBrush x:Key="ComboSelectedBrush" Color="#0E5A72" />
  <SolidColorBrush x:Key="ComboArrowBgBrush" Color="#0F2A44" />
  <SolidColorBrush x:Key="DropDownBrush" Color="#12324C" />
  <SolidColorBrush x:Key="LinkBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="FloatPanelBrush" Color="#E60F2A44" />
  <LinearGradientBrush x:Key="CardFaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0B1E33" Offset="0" />
    <GradientStop Color="#0F2A44" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="WindowGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0B1E33" Offset="0" />
    <GradientStop Color="#0F2A44" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryGrad" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#2EC6E6" Offset="0" />
    <GradientStop Color="#00B4D8" Offset="0.55" />
    <GradientStop Color="#0096B8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryHoverGrad" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#4AD0EC" Offset="0" />
    <GradientStop Color="#00B4D8" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HeroGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7ADFF2" Offset="0" />
    <GradientStop Color="#00B4D8" Offset="0.62" />
    <GradientStop Color="#008FB0" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LogoGrad" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#5AD4EC" Offset="0" />
    <GradientStop Color="#00B4D8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0E2740" Offset="0" />
    <GradientStop Color="#0B1E33" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Float3DBrush" StartPoint="0.3,0" EndPoint="0.75,1">
    <GradientStop Color="#3DCCE8" Offset="0" />
    <GradientStop Color="#00B4D8" Offset="0.45" />
    <GradientStop Color="#007A99" Offset="1" />
  </LinearGradientBrush>
</ResourceDictionary>
