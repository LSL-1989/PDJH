<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- pdjh-server：含 context-path /api -->
    <add key="ApiBaseUrl" value="http://127.0.0.1:8081/api" />
    <!-- 原生 STOMP WebSocket（无 SockJS） -->
    <add key="WsUrl" value="ws://127.0.0.1:8081/api/pdjh-ws-native" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
